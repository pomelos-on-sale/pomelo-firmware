CONFIG_IDF_TARGET="esp32s3"

# CPU Frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Flash 16MB QIO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Octal PSRAM 8MB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Direct all normal heap allocations (including Rust data structures) to 8MB/16MB PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# Strictly reserve 48KB of internal SRAM for critical DMA buffers, FreeRTOS stacks & semaphores
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# Custom Partition Table (11MB LittleFS storage)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Console over USB-Serial-JTAG for Waveshare AMOLED board
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Main task stack size (Rust runtime benefits from adequate stack: 64KB)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# Completely disable Brownout Detector to prevent battery voltage ripple reset loops
# CONFIG_ESP_BROWNOUT_DET is not set

# Wi-Fi station support (used by board_wifi.c and the Wi-Fi HAL).
# NOTE: Wi-Fi buffers are allocated from internal RAM; if boot-time allocation
# fails on hardware, revisit CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL and the
# CONFIG_ESP_WIFI_*_BUFFER_NUM options.
CONFIG_ESP_WIFI_ENABLED=y

# FatFS SD Card configuration (UTF-8 and Long File Name support)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_VOLUME_COUNT=2

# HTTP / HTTPS / TLS & SNTP Configuration
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_MAX_CERTS=200
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_X509_TRUSTED_CERT_CALLBACK=y

